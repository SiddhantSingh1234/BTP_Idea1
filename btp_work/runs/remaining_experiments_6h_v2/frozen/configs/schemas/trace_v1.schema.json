{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btp:neutral_atom_trace:v1",
  "title": "Neutral atom trace v1: metadata.json or one events.jsonl record",
  "oneOf": [{"$ref": "#/$defs/metadata"}, {"$ref": "#/$defs/event"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "site": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "sites": {"type": "array", "items": {"$ref": "#/$defs/site"}},
    "nullableTime": {"type": ["number", "null"], "minimum": 0},
    "metadata": {
      "type": "object",
      "required": ["schema_version", "circuit", "circuit_sha256", "hardware", "hardware_sha256", "events_sha256", "origin", "timing_policy", "diagnostics", "assumptions", "atom_identity_policy", "physical_evidence_complete"],
      "properties": {
        "schema_version": {"const": "neutral_atom_trace.v1"},
        "circuit_sha256": {"$ref": "#/$defs/hash"},
        "hardware_sha256": {"$ref": "#/$defs/hash"},
        "events_sha256": {"$ref": "#/$defs/hash"},
        "timing_policy": {"enum": ["evidence", "two_transfer_stages"]},
        "atom_identity_policy": {"type": "string"},
        "physical_evidence_complete": {"type": "boolean"},
        "origin": {"type": "object", "required": ["kind"]},
        "diagnostics": {"type": "array", "items": {"type": "object", "required": ["code"]}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "circuit": {
          "type": "object", "required": ["format", "num_qubits", "gates"],
          "properties": {
            "format": {"const": "cz_circuit.v1"}, "num_qubits": {"type": "integer", "minimum": 0},
            "gates": {"type": "array", "items": {"type": "object", "required": ["gate_id", "gate_type", "qubits", "dependencies", "logical_layer"],
              "properties": {"gate_id": {"type": "string"}, "gate_type": {"const": "cz"},
                "qubits": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
                "dependencies": {"type": "array", "items": {"type": "string"}}, "logical_layer": {"type": "integer", "minimum": 1}}}}
          }
        },
        "hardware": {"type": "object", "required": ["profile_id", "rows", "columns", "spacing_um", "interaction_radius_um", "restriction_radius_um", "min_atom_separation_um", "slm_aod_shared_plane", "addressing", "aod_count", "source", "assumptions"],
          "properties": {"profile_id": {"type": "string"}, "rows": {"type": "integer", "minimum": 1}, "columns": {"type": "integer", "minimum": 1},
            "spacing_um": {"type": "number", "exclusiveMinimum": 0}, "interaction_radius_um": {"type": "number", "exclusiveMinimum": 0},
            "restriction_radius_um": {"type": "number", "exclusiveMinimum": 0}, "min_atom_separation_um": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "slm_aod_shared_plane": {"type": ["boolean", "null"]}, "addressing": {"enum": ["individual", "global"]}, "aod_count": {"type": "integer", "minimum": 0}}}
      }
    },
    "event": {
      "type": "object",
      "required": ["event_id", "kind", "logical_layer", "placement_batch", "routing_batch", "start_us", "duration_us", "resources", "atom_ids", "logical_qubit_ids", "provenance"],
      "properties": {
        "event_id": {"type": "string"}, "kind": {"enum": ["initialize", "transfer", "move", "gate", "wait", "cooling"]},
        "logical_layer": {"type": ["integer", "null"], "minimum": 1},
        "placement_batch": {"type": ["string", "null"]}, "routing_batch": {"type": ["string", "null"]},
        "start_us": {"$ref": "#/$defs/nullableTime"}, "duration_us": {"$ref": "#/$defs/nullableTime"},
        "resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "atom_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "logical_qubit_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "from_sites": {"$ref": "#/$defs/sites"}, "to_sites": {"$ref": "#/$defs/sites"},
        "trap_from": {"type": "string"}, "trap_to": {"type": "string"}, "provenance": {"type": "object"},
        "trajectory": {"type": ["object", "null"]}, "gate_id": {"type": "string"}, "gate_batch": {"type": "string"},
        "gate_type": {"const": "cz"}, "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "initialize"}}}, "then": {"required": ["to_sites", "trap_to"]}},
        {"if": {"properties": {"kind": {"const": "transfer"}}}, "then": {"required": ["trap_from", "trap_to"]}},
        {"if": {"properties": {"kind": {"const": "move"}}}, "then": {"required": ["from_sites", "to_sites", "trajectory"]}},
        {"if": {"properties": {"kind": {"const": "gate"}}}, "then": {"required": ["gate_id", "gate_type", "gate_batch", "dependencies"]}}
      ]
    }
  }
}
